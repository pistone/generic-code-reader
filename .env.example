# ==============================================================================
# LLM PROVIDER CONFIGURATION
# ==============================================================================
# Main LLM model for study_agent, reviewer_agent, auditor, ticket_agent
# Format: <provider>/<model_name>
# Examples:
#   - openai/gpt-4o
#   - openai/qwen3-coder-320b  (for Qwen via OpenAI-compatible API)
#   - anthropic/claude-sonnet-4.5
#   - ollama/llama3.1  (local, no API key needed)
LLM_MODEL=openai/gpt-4o

# Company LLM Portal (if using internal/proxy server)
# For LiteLLM proxy servers - set to your proxy endpoint
OPENAI_URL=https://your-company-llm-portal.com
OPENAI_API_BASE=https://your-company-llm-portal.com

# API Key - CRITICAL: Get the correct key from your LLM portal admin
# For LiteLLM proxy: this must be registered in the proxy's token database
OPENAI_API_KEY=sk-your-api-key-here

# Alternative: Anthropic API (if not using OpenAI-compatible endpoint)
# ANTHROPIC_API_KEY=sk-ant-...

# ==============================================================================
# R2R VECTOR DATABASE CONFIGURATION
# ==============================================================================
R2R_URL=http://localhost:7272

# Optional: MCP server search result limit
KB_SEARCH_LIMIT=5
