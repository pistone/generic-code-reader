# LLM provider — pick one (used by study_agent and reviewer_agent)
# OpenAI (default)
OPENAI_API_KEY=sk-...
# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# Ollama (no key needed, just: brew install ollama && ollama pull llama3.1)

# Override the default LLM model (default: openai/gpt-4o)
# LLM_MODEL=ollama/llama3.1

# R2R vector database
R2R_URL=http://localhost:7272

# R2R embedding provider (set in compose.yaml)
VOYAGE_API_KEY=pa-...
