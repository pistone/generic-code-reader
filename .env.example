# ==============================================================================
# REQUIRED — Set at least one LLM provider key
# ==============================================================================
# Format: <provider>/<model_name> (uses litellm routing)
# Examples: openai/gpt-4o, anthropic/claude-sonnet-4-20250514, ollama/llama3.1
LLM_MODEL=openai/gpt-4o

# Set the API key for your chosen provider:
OPENAI_API_KEY=sk-your-api-key-here
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...

# ==============================================================================
# OPTIONAL — Defaults work for standard setups
# ==============================================================================
# R2R vector database URL (default: http://localhost:7272)
R2R_URL=http://localhost:7272

# MCP server: max search results returned (default: 5)
# KB_SEARCH_LIMIT=5

# ==============================================================================
# ADVANCED — Only needed for company proxy / custom LLM endpoints
# ==============================================================================
# If using an OpenAI-compatible proxy (e.g. LiteLLM proxy, Azure, vLLM):
# OPENAI_API_BASE=https://your-company-llm-portal.com
